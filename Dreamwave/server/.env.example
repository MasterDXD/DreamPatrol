# 巡梦 (Dreamwave) 服务端环境变量配置
# 复制此文件为 .env 并填写实际值

# JWT密钥（必填，至少32字符随机字符串）
JWT_SECRET=your-secret-key-here-at-least-32-chars

# JWT过期时间（可选，默认7d）
JWT_EXPIRES_IN=7d

# 管理员初始密码（可选，默认admin123，强烈建议修改）
ADMIN_PASSWORD=admin123

# CORS允许的来源（可选，默认http://localhost:5173,http://localhost:5174）
# 多个用英文逗号分隔；生产环境需替换为实际域名
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 服务端口（可选，默认3100）
PORT=3100
